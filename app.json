{
  "expo": {
    "name": "COpter Pilot",
    "slug": "COpterPilot",
    "version": "1.2.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "copterpilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.copterpilot.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Wir benötigen Ihren Standort, um die Wetterdaten und Luftraumkarte für Ihren Flugstandort anzuzeigen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E2132",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.copterpilot.rc",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "versionCode": 3,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E2132",
          "dark": {
            "backgroundColor": "#081521"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wir benötigen Ihren Standort für die Wetter- und Luftraumprüfung."
        }
      ],
      "expo-audio",
      "expo-mail-composer",
      "expo-font",
      "@maplibre/maplibre-react-native",
      "./plugins/withReleaseSigning",
      "./plugins/withRadarForegroundService",
      "./plugins/withAsyncStorageSize",
      "./plugins/withDjiAppQueries",
      "./plugins/withRcKeyEvents",
      "./plugins/withAlertOverlay",
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": false
    }
  }
}
