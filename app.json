{
  "expo": {
    "name": "COpter Pilot",
    "slug": "COpterPilot",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "copterpilot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.copterpilot.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Wir benötigen Ihren Standort, um die Wetterdaten und Luftraumkarte für Ihren Flugstandort anzuzeigen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A4D8C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.copterpilot.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A4D8C",
          "dark": {
            "backgroundColor": "#1A202C"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wir benötigen Ihren Standort für die Wetter- und Luftraumprüfung."
        }
      ],
      "expo-audio",
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
