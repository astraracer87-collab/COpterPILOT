					<description><![CDATA[<table style="font-family:Arial,Verdana,Times;font-size:12px;width:100%;border-collapse:collapse;background:#ffffff;">

<tr style="background:#ffff00;">
<td colspan="2" style="border:1px solid black;padding:9px;text-align:center;">
<div style="font-weight:bold;font-size:16px;color:#1a1305;">PODMIENENÁ PREVÁDZKA UAS</div>
<div style="font-size:12px;font-style:italic;font-weight:normal;color:#1a1305;opacity:0.9;margin-top:3px;">CONDITIONAL UAS OPERATION</div>
</td>
</tr>

<tr>
<td style="border:1px solid black;padding:6px;width:35%;background:#f4f4f4;">
    <div style="font-weight:bold;">Označenie</div>
    <div style="font-size:10px;font-style:italic;font-weight:normal;color:#666666;border-top:1px dotted #999999;margin-top:3px;padding-top:2px;">Identification</div>
  </td>
<td style="border:1px solid black;padding:6px;">RUAS004M</td>
</tr>
<tr>
<td style="border:1px solid black;padding:6px;background:#f4f4f4;">
    <div style="font-weight:bold;">Obmedzenie</div>
    <div style="font-size:10px;font-style:italic;font-weight:normal;color:#666666;border-top:1px dotted #999999;margin-top:3px;padding-top:2px;">Restriction</div>
  </td>
<td style="border:1px solid black;padding:6px;">Let UAS povolený na základe predchádzajúceho súhlasu správcu príslušného chráneného objektu / UAS flight permitted only with the prior approval of the operator of the relevant protected facility.</td>
</tr>
<tr>
<td style="border:1px solid black;padding:6px;background:#f4f4f4;">
    <div style="font-weight:bold;">Doba platnosti</div>
    <div style="font-size:10px;font-style:italic;font-weight:normal;color:#666666;border-top:1px dotted #999999;margin-top:3px;padding-top:2px;">Validity period</div>
  </td>
<td style="border:1px solid black;padding:6px;"><div>stála</div><div style="font-size:10px;font-style:italic;color:#666666;border-top:1px dotted #cccccc;margin-top:3px;padding-top:2px;">permanent</div></td>
</tr>
<tr>
<td style="border:1px solid black;padding:6px;background:#f4f4f4;">
    <div style="font-weight:bold;">Výška</div>
    <div style="font-size:10px;font-style:italic;font-weight:normal;color:#666666;border-top:1px dotted #999999;margin-top:3px;padding-top:2px;">Height</div>
  </td>
<td style="border:1px solid black;padding:6px;">GND - 120m AGL</td>
</tr>

</table>]]></description>
